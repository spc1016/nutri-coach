<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_grid_bg"
    android:padding="16dp">

    <!-- Brand Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notification_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/notification_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="NutriCoach"
            android:textColor="@color/primary_neon_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:layout_marginTop="8dp"
        android:text="Press Banca"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:singleLine="true" />

    <TextView
        android:id="@+id/notification_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/notification_title"
        android:layout_marginTop="2dp"
        android:text="Serie 2 de 4"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/notification_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/notification_text"
        android:layout_marginTop="16dp"
        android:progress="50"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:progressTint="@color/primary_neon_green" />

    <LinearLayout
        android:id="@+id/actions_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/notification_progress"
        android:layout_marginTop="12dp"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/action_finish_set"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_notification_finish"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/action_stop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_notification_stop"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</RelativeLayout>
